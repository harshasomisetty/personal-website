---
import PageHeader from '@/components/PageHeader.astro';
import Base from '@/layouts/Base.astro';
import {
  continentCount,
  countryCount,
  places,
  regions,
  territoryCount,
  trips,
  worldPercent,
} from '@/been';
import { geoEqualEarth, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';

// The map renders to a static SVG at build time; the page ships no map JavaScript.
const width = 960;
const height = 470;
const countries = feature(world as any, (world as any).objects.countries) as any;
const projection = geoEqualEarth().fitSize([width, height], countries);
const path = geoPath(projection).digits(1);
const visited = new Set(places.map((p) => p.id));
const shapes = countries.features.map((f: any) => ({
  d: path(f),
  visited: visited.has(f.id),
}));
const dots = places
  .filter((p) => p.dot)
  .map((p) => ({ name: p.name, xy: projection(p.dot!)! }));

// Timeline: trips grouped by year, newest first. A typo in a trip fails the build.
const byName = new Map(places.map((p) => [p.name, p]));
for (const t of trips)
  for (const n of t.places) if (!byName.has(n)) throw new Error(`been.ts trip: unknown place "${n}"`);
const years = [...new Set(trips.map((t) => t.year))];
const inTrips = new Set(trips.flatMap((t) => t.places));
const undated = places.filter((p) => !inTrips.has(p.name) && p.name !== 'United States');

const stats = [
  { value: countryCount, label: 'Countries' },
  { value: `${worldPercent}%`, label: 'Of the world' },
  { value: `${continentCount}/7`, label: 'Continents' },
];
---

<Base
  title="Been"
  description={`The ${countryCount} countries, ${territoryCount} territories, and Antarctica that Harsha Somisetty has been to.`}
>
  <PageHeader
    title="Been"
    description={`${countryCount} countries, ${territoryCount} territories, and Antarctica.`}
  />

  <svg
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label="World map with the visited countries in orange"
    class="w-full h-auto"
  >
    {
      shapes.map((s: { d: string; visited: boolean }) => (
        <path
          d={s.d}
          class={s.visited ? 'fill-amber-500' : 'fill-neutral-800'}
          stroke="hsl(0 0% 3.9%)"
          stroke-width="0.5"
        />
      ))
    }
    {
      dots.map(({ name, xy }) => (
        <circle cx={xy[0]} cy={xy[1]} r="3.5" class="fill-amber-500" stroke="hsl(0 0% 3.9%)" stroke-width="1">
          <title>{name}</title>
        </circle>
      ))
    }
  </svg>

  <div class="mt-8 grid grid-cols-3 gap-4 text-center">
    {
      stats.map((s) => (
        <div>
          <p class="text-3xl font-bold text-amber-500">{s.value}</p>
          <p class="mt-1 text-sm text-neutral-500">{s.label}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-12 space-y-10">
    {
      regions.map((region) => (
        <section>
          <h2 class="mb-3 text-xl font-bold">{region}</h2>
          <ul class="grid gap-x-6 gap-y-2 sm:grid-cols-2">
            {places
              .filter((p) => p.region === region)
              .map((p) => {
                const extra = [
                  p.cities?.length === 1 && p.cities[0],
                  p.note,
                  p.territory && p.id !== '010' && `part of ${p.territory}`,
                ]
                  .filter(Boolean)
                  .join(' · ');
                return (p.cities?.length ?? 0) > 1 ? (
                  <li>
                    <details class="group">
                      <summary class="flex cursor-pointer list-none items-baseline gap-2 [&::-webkit-details-marker]:hidden">
                        <span aria-hidden="true">{p.flag}</span>
                        <span class="text-neutral-200 underline underline-offset-4 decoration-neutral-600 group-hover:decoration-neutral-200">
                          {p.name}
                        </span>
                        <span class="text-sm text-neutral-500">{p.cities!.length} cities</span>
                        <svg
                          aria-hidden="true"
                          viewBox="0 0 16 16"
                          class="size-3 self-center text-neutral-500 transition-transform group-open:rotate-90"
                        >
                          <path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </summary>
                      <ul class="mt-1 mb-2 ml-7 space-y-0.5 text-sm text-neutral-400">
                        {p.cities!.map((c) => <li>{c}</li>)}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li class="flex items-baseline gap-2">
                    <span aria-hidden="true">{p.flag}</span>
                    <span class="text-neutral-200">{p.name}</span>
                    {extra && <span class="text-sm text-neutral-500">{extra}</span>}
                  </li>
                );
              })}
          </ul>
        </section>
      ))
    }
  </div>

  <section class="mt-14">
    <h2 class="mb-1 text-xl font-bold">Timeline</h2>
    <p class="mb-6 text-sm text-neutral-500">Trips outside the US, from the locations in my photos.</p>
    <div class="relative border-l border-neutral-800 ml-1.5">
      {
        years.map((year) => (
          <div class="mb-6">
            <p class="mb-3 -ml-px pl-6 font-mono text-sm text-neutral-500">{year}</p>
            <ul class="space-y-4">
              {trips
                .filter((t) => t.year === year)
                .map((t) => (
                  <li class="relative pl-6">
                    <span class="absolute -left-[5px] top-2 size-2.5 rounded-full bg-amber-500" />
                    <p class="text-neutral-200">
                      {t.places.map((n, i) => (
                        <>
                          {i > 0 && <span class="text-neutral-600"> → </span>}
                          <span class="whitespace-nowrap">
                            <span aria-hidden="true">{byName.get(n)!.flag}</span> {n}
                          </span>
                        </>
                      ))}
                    </p>
                    <p class="text-sm text-neutral-500">{t.when} {t.year}</p>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
    {
      undated.length > 0 && (
        <p class="mt-2 text-sm text-neutral-500">
          Before 2019, dates unknown: {undated.map((p) => p.name).join(', ')}.
        </p>
      )
    }
  </section>
</Base>
