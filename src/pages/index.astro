---
import PassportCard from '@/components/PassportCard.astro';
import Base from '@/layouts/Base.astro';
import { bio, business, featuredPosts, hook, linkGroups, projects, roles } from '@/site';
import { getCollection } from 'astro:content';

const all = await getCollection('blog');
const posts = featuredPosts.map((id) => {
  const post = all.find((p) => p.id === id);
  if (!post) throw new Error(`featuredPosts: no post content/blog/${id}.mdx`);
  return post;
});
const monthYear = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const external = (href: string) => !href.startsWith('/');
const heading = 'font-mono text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500';
---

<Base>
  <div class="w-full max-w-[520px] mx-auto">
    <section>
      <div class="flex items-center gap-4">
        <img
          src="/avatar-400.jpg"
          alt={business.founder}
          width="64"
          height="64"
          class="rounded-full size-16 object-cover"
        />
        <div>
          <h1 class="font-bold text-2xl">{business.founder}</h1>
          <p class="mt-0.5 font-mono text-xs text-neutral-500">{roles.join(' · ')}</p>
        </div>
      </div>
      <div class="mt-5 space-y-2 text-[15px] font-light text-neutral-300 leading-relaxed">
        {bio.map((line) => <p>{line}</p>)}
      </div>
      <p class="mt-3 text-base">{hook}</p>

      <dl class="mt-6 grid grid-cols-[4.5rem_1fr] gap-x-3 gap-y-2 text-[15px]">
        {
          linkGroups.map(({ title, links }) => (
            <>
              <dt class="pt-1 font-mono text-[11px] uppercase tracking-widest text-neutral-500">{title}</dt>
              <dd class="flex flex-wrap gap-x-4 gap-y-1">
                {links.map(({ title, href }) => (
                  <a
                    href={href}
                    {...(external(href) && { target: '_blank', rel: 'noopener noreferrer' })}
                    class="text-neutral-200 underline underline-offset-4 decoration-neutral-600 transition-colors hover:decoration-neutral-200"
                  >
                    {title}
                  </a>
                ))}
              </dd>
            </>
          ))
        }
      </dl>
    </section>

    <section class="mt-12">
      <h2 class={`mb-4 ${heading}`}>Travel</h2>
      <PassportCard />
    </section>

    <section class="mt-12">
      <h2 class={`mb-3 flex justify-between ${heading}`}>
        <a href="/blog" class="hover:text-neutral-200">Writing</a>
        <a href="/blog" class="font-normal normal-case tracking-normal hover:text-neutral-200">All →</a>
      </h2>
      <ul class="space-y-2">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="flex items-baseline justify-between gap-4 group">
                <span class="text-neutral-200 group-hover:underline underline-offset-4">{post.data.title}</span>
                <span class="shrink-0 font-mono text-xs text-neutral-500">{monthYear(post.data.date)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class={`mb-3 flex justify-between ${heading}`}>
        <a href="/projects" class="hover:text-neutral-200">Work</a>
        <a href="/projects" class="font-normal normal-case tracking-normal hover:text-neutral-200">All →</a>
      </h2>
      <ul class="space-y-3">
        {
          projects.slice(0, 3).map((project) => (
            <li>
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-baseline justify-between gap-4 group"
              >
                <span>
                  <span class="block text-neutral-200 group-hover:underline underline-offset-4">{project.title}</span>
                  <span class="block text-[13px] text-neutral-500">{project.summary}</span>
                </span>
                <span class="shrink-0 font-mono text-xs text-neutral-500">{project.year}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
