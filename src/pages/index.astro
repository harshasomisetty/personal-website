---
import Base from '@/layouts/Base.astro';
import { business, projects, socials, taglineLines } from '@/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const monthYear = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base>
  <section class="flex flex-col items-center">
    <img
      src="/avatar-400.jpg"
      alt={business.founder}
      width="100"
      height="100"
      class="rounded-full w-[100px] h-[100px] object-cover"
    />
    <h1 class="mt-6 font-bold text-3xl font-serif text-center">
      {business.founder}
    </h1>
    <p class="mt-2 text-neutral-400 text-center">
      {taglineLines.map((line) => <span class="block">{line}</span>)}
    </p>
    <div class="mt-5 flex flex-wrap justify-center gap-4">
      {
        socials.map(({ title, href, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={title}
            title={title}
            class="size-6 text-neutral-400 transition-colors hover:text-white [&>svg]:size-full"
            set:html={icon}
          />
        ))
      }
    </div>
  </section>

  <div class="mt-10 w-full max-w-[520px] mx-auto space-y-12">
    <section class="space-y-3 text-center text-neutral-200 leading-relaxed">
      <p>
        I grew up as a kid who tied his value to results. I taught myself
        programming at 16, triple majored in Mathematics, Computer Science, and
        Statistics by 20, worked in tech until I semi-retired at 22, and then
        traveled the world. By 24, I had done every material experience the
        world has to offer. Now that there is no other external metric I can
        tackle, I'm at a crossroads of figuring out what matters to the kid
        inside of me.
      </p>
      <p class="text-neutral-400">Say hi at {business.emailText}.</p>
    </section>

    <section>
      <h2 class="mb-3 font-serif text-xl font-bold">Blog</h2>
      <ul class="space-y-2">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="flex items-baseline justify-between gap-4 group"
              >
                <span class="text-neutral-200 group-hover:underline underline-offset-4">
                  {post.data.title}
                </span>
                <span class="shrink-0 font-mono text-xs text-neutral-500">
                  {monthYear(post.data.date)}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="mb-3 font-serif text-xl font-bold">
        <a href="/projects" class="hover:underline underline-offset-4">Projects</a>
      </h2>
      <ul class="space-y-2">
        {
          projects.map((project) => (
            <li>
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="block group"
              >
                <span class="text-neutral-200 group-hover:underline underline-offset-4">
                  {project.title}
                </span>
                <span class="text-neutral-500"> · {project.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
