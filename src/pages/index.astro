---
import Base from '@/layouts/Base.astro';
import { bio, business, hook, projects, socials } from '@/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) =>
    Number(b.data.pinned) - Number(a.data.pinned) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
const monthYear = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base>
  <section class="flex flex-col items-center">
    <img
      src="/avatar-400.jpg"
      alt={business.founder}
      width="100"
      height="100"
      class="rounded-full w-[100px] h-[100px] object-cover"
    />
    <h1 class="mt-6 font-bold text-3xl font-serif text-center">
      {business.founder}
    </h1>
    <div class="mt-3 max-w-[440px] space-y-2 text-center font-light text-neutral-300 leading-relaxed">
      {bio.map((line) => <p>{line}</p>)}
    </div>
    <p class="mt-3 text-center text-lg font-semibold text-balance">{hook}</p>
    <div class="mt-5 flex flex-wrap justify-center gap-4">
      {
        socials.map(({ title, href, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={title}
            title={title}
            class="size-6 text-neutral-400 transition-colors hover:text-white [&>svg]:size-full"
            set:html={icon}
          />
        ))
      }
    </div>
    <p class="mt-4 text-sm font-light text-neutral-500">Say hi at {business.emailText}</p>
  </section>

  <div class="mt-12 w-full max-w-[520px] mx-auto space-y-12">
    <section>
      <h2 class="mb-3 font-serif text-xl font-bold">Writing</h2>
      <ul class="space-y-2">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="flex items-baseline justify-between gap-4 group"
              >
                <span class="text-neutral-200 underline underline-offset-4 decoration-neutral-600 group-hover:decoration-neutral-200">
                  {post.data.title}
                </span>
                <span class="shrink-0 font-mono text-xs text-neutral-500">
                  {post.data.pinned ? 'Pinned · ' : ''}{monthYear(post.data.date)}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="mb-3 font-serif text-xl font-bold">
        <a href="/projects" class="hover:underline underline-offset-4">Projects</a>
      </h2>
      <ul class="space-y-2">
        {
          projects.map((project) => (
            <li>
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="block group"
              >
                <span class="text-neutral-200 group-hover:underline underline-offset-4">
                  {project.title}
                </span>
                <span class="text-neutral-500"> · {project.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
