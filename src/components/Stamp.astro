---
// A passport ink stamp, drawn in SVG at build time. Shape, ink and tilt come from a hash
// of the name, so each country always gets the same stamp. Needs the #ink filter on the page.
interface Props {
  name: string;
  date: string; // "SEP 2026", "HOME", or "" (no date known)
  foot: string; // small text on the bottom edge
}
const { name, date, foot } = Astro.props;

let h = 0;
for (const c of name) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const shapes = ['circle', 'rect', 'octagon', 'oval'] as const;
const inks = ['#fbbf24', '#fb7185', '#38bdf8', '#34d399', '#a78bfa', '#f87171', '#5eead4', '#d4d4d4'];
const shape = shapes[h % shapes.length];
const ink = inks[(h >>> 3) % inks.length];
const tilt = ((h >>> 7) % 17) - 8; // -8..8 degrees
const id = `s${h.toString(36)}`;

const label = name.toUpperCase();
const W = 160;
const H = 120;
// The country name is the big text. A long name with a space goes on two lines, split where
// the longer line is shortest ("DOMINICAN / REPUBLIC").
const words = label.split(' ');
let lines = [label];
if (label.length > (shape === 'circle' ? 8 : 11) && words.length > 1) {
  let best = Infinity;
  for (let i = 1; i < words.length; i++) {
    const two = [words.slice(0, i).join(' '), words.slice(i).join(' ')];
    const long = Math.max(...two.map((l) => l.length));
    if (long < best) [best, lines] = [long, two];
  }
}
// Mono glyphs are about 0.6 em wide. max1/max2 = largest size for one line / two lines.
const nameSize = (width: number, max1: number, max2: number) =>
  Math.min(lines.length > 1 ? max2 : max1, width / (Math.max(...lines.map((l) => l.length)) * 0.62));
// Baselines for the name lines, centered on cy (caps sit about 0.36 em above the baseline).
const nameYs = (cy: number, size: number) =>
  lines.map((_, k) => cy + (k - (lines.length - 1) / 2) * size * 1.08 + size * 0.36);
const octagon = (x: number, y: number, w: number, hh: number, c: number) =>
  `${x + c},${y} ${x + w - c},${y} ${x + w},${y + c} ${x + w},${y + hh - c} ${x + w - c},${y + hh} ${x + c},${y + hh} ${x},${y + hh - c} ${x},${y + c}`;
const shapeName = { circle: [90, 59, 18, 15], oval: [110, 52, 21, 16], rect: [124, 47, 22, 17], octagon: [122, 48, 22, 17] } as const;
const [nw, ncy, n1, n2] = shapeName[shape];
const size = nameSize(nw, n1, n2);
const ys = nameYs(ncy, size);
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  class="stamp block w-full h-auto"
  style={`--r:${tilt}deg`}
  aria-hidden="true"
  font-family="'JetBrains Mono Variable', ui-monospace, monospace"
>
  <g filter="url(#ink)" fill={ink} stroke={ink} opacity="0.9">
    {
      shape === 'circle' && (
        <>
          <circle cx="80" cy="60" r="55" fill="none" stroke-width="2.5" />
          <circle cx="80" cy="60" r="46" fill="none" stroke-width="1" />
          <path id={`${id}t`} d="M 43 60 A 37 37 0 0 1 117 60" fill="none" stroke="none" />
          <path id={`${id}b`} d="M 39 60 A 41 41 0 0 0 121 60" fill="none" stroke="none" />
          <text font-size="9" font-weight="700" stroke="none" text-anchor="middle" letter-spacing="1">
            <textPath href={`#${id}t`} startOffset="50%">{date || '★'}</textPath>
          </text>
          <text font-size="6.5" stroke="none" text-anchor="middle" letter-spacing="1.5">
            <textPath href={`#${id}b`} startOffset="50%">{foot}</textPath>
          </text>
        </>
      )
    }
    {
      shape === 'oval' && (
        <>
          <ellipse cx="80" cy="60" rx="76" ry="52" fill="none" stroke-width="2.5" />
          <ellipse cx="80" cy="60" rx="69" ry="45" fill="none" stroke-width="1" />
          <text x="80" y="82" font-size="11" font-weight="700" stroke="none" text-anchor="middle" letter-spacing="1">{date || '★'}</text>
          <text x="80" y="94" font-size="6.5" stroke="none" text-anchor="middle" letter-spacing="1.5">{foot}</text>
        </>
      )
    }
    {
      (shape === 'rect' || shape === 'octagon') && (
        <>
          {shape === 'rect' ? (
            <>
              <rect x="6" y="12" width="148" height="96" rx="6" fill="none" stroke-width="2.5" />
              <rect x="12" y="18" width="136" height="84" rx="3" fill="none" stroke-width="1" />
            </>
          ) : (
            <>
              <polygon points={octagon(6, 10, 148, 100, 20)} fill="none" stroke-width="2.5" />
              <polygon points={octagon(12, 16, 136, 88, 16)} fill="none" stroke-width="1" />
            </>
          )}
          <line x1="34" y1="70" x2="126" y2="70" stroke-width="1" />
          <text x="80" y="84" font-size="11" font-weight="700" stroke="none" text-anchor="middle" letter-spacing="1">{date || '★'}</text>
          <text x="80" y="95" font-size="6" stroke="none" text-anchor="middle" letter-spacing="1.5">{foot}</text>
        </>
      )
    }
    {lines.map((l, k) => (
      <text x="80" y={ys[k]} font-size={size} font-weight="800" stroke="none" text-anchor="middle">{l}</text>
    ))}
  </g>
</svg>

<style>
  .stamp {
    transform: rotate(var(--r));
    transition: transform 200ms ease;
  }
  :global(.stamp-wrap:hover) .stamp,
  :global(details[open]) .stamp {
    transform: rotate(0deg) scale(1.04);
  }
</style>
