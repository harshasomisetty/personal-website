---
// Home page teaser for /passport: a dot-matrix world map (visited countries in amber, home in
// white) and the key numbers under it. Built at build time; no JavaScript on the page.
import { continentCount, countryCount, places } from '@/been';
import flights from '@/flights.json';
import { geoBounds, geoContains, geoEqualEarth } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';

const width = 520;
const height = 254;
const step = 2.4; // degrees between dots
const projection = geoEqualEarth().fitExtent([[2, 2], [width - 2, height - 2]], { type: 'Sphere' } as any);
const visited = new Set(places.map((p) => p.id));
const lands = (feature(world as any, (world as any).objects.countries) as any).features.map((f: any) => ({
  f,
  b: geoBounds(f),
  lit: visited.has(f.id),
}));

// Each dot is a zero-length path segment with a round cap, so a whole layer is one <path>.
const dot = ([x, y]: [number, number]) => `M${x.toFixed(1)} ${y.toFixed(1)}h0`;
let gray = '';
let lit = '';
for (let lat = 84; lat >= -86; lat -= step) {
  for (let lon = -180; lon < 180; lon += step) {
    const hit = lands.find(({ f, b: [[x0, y0], [x1, y1]] }: any) =>
      lat >= y0 && lat <= y1 && (x0 > x1 || (lon >= x0 && lon <= x1)) && geoContains(f, [lon, lat]),
    );
    if (!hit) continue;
    const d = dot(projection([lon, lat])!);
    if (hit.lit) lit += d;
    else gray += d;
  }
}
// Places too small for the grid (islands, city states, Svalbard).
for (const p of places) if (p.dot) lit += dot(projection(p.dot)!);
const pts = flights.points as Record<string, [number, number]>;
const [hx, hy] = projection(pts.EWR)!;
const num = (n: number) => n.toLocaleString('en-US');
---

<a
  href="/passport"
  class="passport group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-500"
>
  <svg viewBox={`0 0 ${width} ${height}`} class="block h-auto w-full" role="img" aria-label={`World map: ${countryCount} countries visited`}>
    <path d={gray} class="dots" />
    <path d={lit} class="dots lit" />
    <circle cx={hx} cy={hy} r="2.6" fill="white" />
  </svg>
  <div class="mt-3 flex items-baseline justify-between gap-3 font-mono text-[11px] text-neutral-500 sm:text-xs">
    <span class="flex flex-wrap gap-x-3 gap-y-1 sm:gap-x-4">
      <span><b class="font-semibold text-neutral-100">{countryCount}</b> countries</span>
      <span><b class="font-semibold text-neutral-100">{num(flights.flights)}</b> flights</span>
      <span><b class="font-semibold text-neutral-100">{continentCount}</b> continents</span>
    </span>
    <span class="shrink-0 text-amber-500">
      Passport <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>

<style>
  .dots {
    fill: none;
    stroke: #2e2e2e;
    stroke-width: 2.1;
    stroke-linecap: round;
  }
  .dots.lit {
    stroke: #f59e0b;
    transition: stroke 0.3s;
  }
  .group:hover .dots.lit {
    stroke: #fbbf24;
  }
</style>
